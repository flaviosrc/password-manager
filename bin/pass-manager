#!/usr/bin/env bash

set -euo pipefail
umask 077

script_name=$(basename "$0")

erro() { echo "$script_name: $*" >&2; exit 1; }

help() {
    cat >&2 <<EOF
Usage:
    $script_name new ~/pass/github     # create new pass file
    $script_name get ~/pass/github     # get pass file content
    $script_name edit ~/pass/github    # edit pass file
Requires:
    gpg          # gnupg package for cripto
    \$GPG_ID     # export GPG_ID=\"your@email.com\"
Optional:
    \$EDITOR     # if not set, use vim as default 
EOF
    exit 1
}

command -v gpg >/dev/null || erro "gpg not found. install gnupg package"

require_gpg_id() {
    [ -n "${GPG_ID:-}" ] || erro "set GPG_ID (ex: export GPG_ID=\"your@email.com\")"
    gpg --list-keys "$GPG_ID" >/dev/null 2>&1 || erro "public key '$GPG_ID' not found"
}

TEMP=""

clear_temp() {
    if [ -n "$TEMP" && -e "$TEMP" ]; then
        shred -u "$TEMP" 2>/dev/null || rm -f "$TEMP"
    fi
}

trap clear_temp EXIT
trap 'exit 130' INT TERM

make_temp() {
    TEMP=$(mktemp)
}

open_editor() {
    "${EDITOR:-vim}" "$TEMP"
}

encrypt() {
    local pass_file="$1"
    gpg -q -e -r "$GPG_ID" -o "$pass_file.tmp" "$TEMP"
    mv -f "$pass_file.tmp" "$pass_file"
}

cmd_add() {
    local pass_file="$1"
    [ "$pass_file" == *.gpg ] || pass_file="$pass_file.gpg"
    [ -e "$pass_file" ] && erro "'$pass_file' already exist"

    require_gpg_id

    mkdir -p "$(dirname "$pass_file")"

    make_temp
    open_editor

    if [ ! -s "$TEMP" ]; then
        echo "empty pass file"
        return
    fi

    encrypt "$pass_file"
    echo "created $pass_file"
}

cmd_edit() {
    local pass_file="$1" hash_before hash_after
    [ -f "$pass_file" ] || erro "'$pass_file' not found"

    require_gpg_id
    make_temp

    gpg -q -d "$pass_file" > "$TEMP" || erro "decrypt fail for '$pass_file'"
    hash_before=$(sha256sum < "$TEMP")

    open_editor

    hash_after=$(sha256sum < "$TEMP")
    if [ "$hash_before" == "$hash_after" ]; then
        echo "no changes"
        return
    fi

    encrypt "$pass_file"
    echo "updated $pass_file"
}

cmd_get() {
    local pass_file="$1"
    [ -f "$pass_file" ] || erro "'$pass_file' not found"
    gpg -q -d "$pass_file" || erro "decrypt fail for '$pass_file'"
}

[ $# -eq 2 ] || help

case "$1" in
    add)  cmd_add  "$2" ;;
    edit) cmd_edit "$2" ;;
    get)  cmd_get  "$2" ;;
    *)    help ;;
esac
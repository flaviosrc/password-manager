#!/usr/bin/env bash

set -euo pipefail
umask 077

script_name=$(basename "$0")

erro() { echo "$script_name: $*" >&2; exit 1; }

help() {
    cat >&2 <<EOF
Usage:
    $script_name [option] FILE
Options:
    gen BYTES    generate random password
    save FILE    save password in FILE
    read FILE    read password from FILE
    update FILE  overwrites password in FILE
Example:
    \$ $script_name gen 32                               # generate random 32 bytes password
    \$ $script_name save password                        # save password in file named password
    \$ $script_name read password                        # read password from file named password
    \$ $script_name update password                      # overwrites password in file named password
    \$ $script_name gen 32 | $script_name save password  # generate and save random password in file named password
Requires:
    gpg          # gnupg package for cripto
    GPG_ID       # export GPG_ID=\"your@email.com\"
EOF
    exit 1
}

command -v gpg >/dev/null || erro "gpg not found. install gnupg package"

require_gpg_id() {
    [ -n "${GPG_ID:-}" ] || erro "set GPG_ID (ex: export GPG_ID=\"your@email.com\")"
    gpg --list-keys "$GPG_ID" >/dev/null 2>&1 || erro "public key '$GPG_ID' not found"
}

encrypt() {
    local content="$1" file="$2" 
    printf '%s' "$content" | gpg -q -e -r "$GPG_ID" -o "$file.tmp"
    mv -f "$file.tmp" "$file"
}

cmd_save() {
    local file="$1"
    [ -e "$file" ] && erro "'$file' already exist"

    require_gpg_id

    mkdir -p "$(dirname "$file")"

    read -s -p "password: " content
    echo

    if [ ! "$content" ]; then
        echo "empty password"
        return
    fi

    encrypt "$content" "$file"
    echo "created $file"
}

cmd_update() {
    local file="$1"
    [ -f "$file" ] || erro "'$file' not found"

    require_gpg_id

    read -s -p "password: " content
    echo

    encrypt "$content" "$file"
    echo "updated $file"
}

cmd_read() {
    local file="$1"
    [ -f "$file" ] || erro "'$file' not found"
    gpg -q -d "$file" || erro "decrypt fail for '$file'"
    echo
}

cmd_gen() {
    local bytes="${1:-32}"
    gpg --gen-random 2 $bytes | base64 || openssl rand -base64 $bytes
}

[ $# -eq 2 ] || help

case "$1" in
    gen)     cmd_gen  "$2" ;;
    save)    cmd_save  "$2" ;;
    update)  cmd_update "$2" ;;
    read)    cmd_read  "$2" ;;
    *)       help ;;
esac